"use strict";
// write code here
var allELem = document.querySelector("ul");
var listOfEmployee = Array.from(document.querySelectorAll("li"));
function parseSalary(str) {
    return Number(str.replaceAll("$", "").replaceAll(",", ""));
}
function sortList(list, listElement) {
    for(var i = 0; i < list.length - 1; i++){
        var ref;
        for(var j = 0; j < list.length - 1 - i; j++)if (parseSalary(list[j].dataset.salary) < parseSalary(list[j + 1].dataset.salary)) ref = [
            list[j + 1],
            list[j]
        ], list[j] = ref[0], list[j + 1] = ref[1], ref;
    }
    list.forEach(function(li) {
        return listElement.appendChild(li);
    });
}
function getEmployees(list) {
    var employees = [];
    list.forEach(function(li) {
        return employees.push({
            name: li.textContent,
            position: li.dataset.position,
            salary: li.dataset.salary,
            age: li.dataset.age
        });
    });
    return employees;
}
sortList(listOfEmployee, allELem);
getEmployees(listOfEmployee);

